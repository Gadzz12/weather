APP_PORT=8080
APP_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=go_vibe_weather_db
DB_SSLMODE=disable

# External Weather API Key (BMKG)
# BMKG publik tidak memerlukan API key, boleh dikosongkan
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.bmkg.go.id

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRATION_HOURS=24

# CORS Configuration (opsional, gunakan * untuk mengizinkan semua domain/hosting frontend)
ALLOWED_ORIGINS=*
